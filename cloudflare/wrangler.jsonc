{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hanzi-steps-api",
  "main": "worker.ts",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://weather-mister.github.io",
    "PUSH_ENABLED": "false"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "hanzi-steps",
    "database_id": "REPLACE_WITH_CREATED_D1_ID",
    "migrations_dir": "migrations"
  }],
  "durable_objects": {"bindings": [{"name":"WIDGET_EVENTS","class_name":"WidgetEvents"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["WidgetEvents"]}],
  "triggers": {"crons": ["15 * * * *"]},
  "observability": {"enabled": true}
}
