{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hanzi Steps Book 1 Audit Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "auditId",
    "stage",
    "mode",
    "verdict",
    "inputs",
    "findings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "auditId": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "mode": {
      "enum": ["fresh-context", "builder-context", "deterministic"]
    },
    "verdict": {
      "enum": ["PASS", "FAIL", "HUMAN_REVIEW"]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ref"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "status",
          "summary",
          "scope",
          "blastRadius"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["BLOCKER", "MAJOR", "MINOR"] },
          "status": { "enum": ["OPEN", "RESOLVED", "ACCEPTED_MINOR"] },
          "summary": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "blastRadius": {
            "enum": ["LOCAL", "ACTIVITY", "UNIT", "CROSS_UNIT", "CURRICULUM", "SOURCE"]
          },
          "evidence": { "type": "string" },
          "resolution": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
