[{"id":"hello","title":"Say hello","subtitle":"Your first two characters","chars":["你","好"],"minutes":"5–7 min","steps":[{"type":"intro","char":"你","id":"你-0"},{"type":"trace","char":"你","id":"你-1"},{"type":"parts","char":"你","prompt":"Which part of 你 is the person component?","options":["亻","尔","口"],"answer":"亻","explanation":"亻 is the side form of 人 (person). It is the two-stroke component on the left.","id":"你-2"},{"type":"build","char":"你","id":"你-3"},{"type":"complete","char":"你","id":"你-4"},{"type":"select","char":"你","prompt":"Which character means “you”?","answer":"你","options":["你","好","我","是"],"explanation":"你 (nǐ) means you.","id":"你-5"},{"type":"memory","char":"你","id":"你-6"},{"type":"intro","char":"好","id":"好-0"},{"type":"trace","char":"好","id":"好-1"},{"type":"parts","char":"好","prompt":"Which component is on the right of 好?","options":["口","子","亻"],"answer":"子","explanation":"好 has 女 (woman) on the left and 子 (child) on the right.","id":"好-2"},{"type":"build","char":"好","id":"好-3"},{"type":"complete","char":"好","id":"好-4"},{"type":"select","char":"好","prompt":"Which character means “good; well”?","answer":"好","options":["好","你","我","是"],"explanation":"好 (hǎo) means good; well.","id":"好-5"},{"type":"memory","char":"好","id":"好-6"},{"type":"match","chars":["你","好"],"id":"hello-0"},{"type":"phrase","phrase":"hello","id":"hello-1"},{"type":"order","phrase":"hello","tokens":["好","你","我"],"id":"hello-2"}],"unitId":"unit-1","review":false},{"id":"identity","title":"Talk about yourself","subtitle":"I · am / is / are","chars":["我","是"],"minutes":"5–7 min","steps":[{"type":"intro","char":"我","id":"我-0"},{"type":"trace","char":"我","id":"我-1"},{"type":"complete","char":"我","id":"我-2"},{"type":"select","char":"我","prompt":"Which character means “I; me”?","answer":"我","options":["我","你","好","是"],"explanation":"我 (wǒ) means I; me.","id":"我-3"},{"type":"memory","char":"我","id":"我-4"},{"type":"intro","char":"是","id":"是-0"},{"type":"trace","char":"是","id":"是-1"},{"type":